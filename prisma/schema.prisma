// ============================================================
// CHURCH PLATFORM - DATABASE SCHEMA
// ============================================================
// Authentication:
// Clerk is the source of truth for authentication.
// We only store the Clerk user ID and application-specific data.
//
// Storage:
// - Images / audio files -> ImageKit
// - Videos -> YouTube
//
// Database:
// PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  EDITOR
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum MediaType {
  SERMON
  SONG
  MEETING
  OTHER
}

enum MediaStatus {
  DRAFT
  PUBLISHED
}

enum VideoStatus {
  DRAFT
  PUBLISHED
}

enum PostCategory {
  CONSTRUCTION
  EVENT
  ACTIVITY
  ANNOUNCEMENT
  CHURCH_LIFE
  OTHER
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum QuoteStatus {
  DRAFT
  PUBLISHED
}

enum InteractionType {
  COMMENT
  GREETING
}

enum InteractionStatus {
  NEW
  READ
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(cuid())

  // Clerk identity
  clerkId String @unique

  // Basic application profile
  firstName String?
  lastName  String?
  email     String?

  imageUrl String?

  role UserRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Content created by this user
  events        Event[]
  media         Media[]
  youtubeVideos YouTubeVideo[]
  posts         Post[]
  sermonQuotes  SermonQuote[]

  @@index([role])
  @@index([createdAt])
}

// ============================================================
// EVENT
// ============================================================

model Event {
  id String @id @default(cuid())

  title String
  slug  String @unique

  description String?

  // Event scheduling
  startAt DateTime
  endAt   DateTime?

  // Location
  location String?

  // Optional contact information
  contactInfo String?

  // Main event image
  coverImageUrl       String?
  coverImageKitFileId String?

  status     EventStatus @default(DRAFT)
  visibility Visibility  @default(PUBLIC)

  // Publication date
  publishedAt DateTime?

  // Author / administrator
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  eventImages EventImage[]

  @@index([status])
  @@index([visibility])
  @@index([startAt])
  @@index([publishedAt])
  @@index([createdById])
}

// ============================================================
// MEDIA
// ============================================================
// Used for audio content.
//
// Examples:
// - Prédications
// - Chansons
// - Réunions
// - Other church audio
//
// Actual audio file is stored in ImageKit.
// The database stores the URL and metadata.
// ============================================================

model Media {
  id String @id @default(cuid())

  title String
  slug  String @unique

  description String?

  type       MediaType
  status     MediaStatus @default(DRAFT)
  visibility Visibility  @default(PUBLIC)

  // Audio file
  audioUrl       String
  imageKitFileId String?

  // Cover image
  coverImageUrl       String?
  coverImageKitFileId String?

  // Optional speaker / artist / responsible person
  speakerName String?

  // Duration in seconds
  durationSeconds Int?

  // Publication
  publishedAt DateTime?

  // Author / administrator
  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
  @@index([createdById])
}

// ============================================================
// YOUTUBE VIDEO
// ============================================================
// The platform DOES NOT store video files.
//
// We only store the YouTube information.
//
// Example:
// https://www.youtube.com/watch?v=XXXXXXXXXXX
//
// youtubeVideoId allows the application to:
// - generate thumbnails
// - create embeds
// - validate duplicates
// ============================================================

model YouTubeVideo {
  id String @id @default(cuid())

  title String
  slug  String @unique

  description String?

  // Original YouTube URL
  youtubeUrl String

  // Extracted YouTube video ID
  youtubeVideoId String @unique

  // YouTube thumbnail
  thumbnailUrl String?

  status     VideoStatus @default(DRAFT)
  visibility Visibility  @default(PUBLIC)

  publishedAt DateTime?

  // Optional metadata
  channelName     String?
  durationSeconds Int?

  // Author / administrator
  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Interactions (commentaires et salutations)
  interactions VideoInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
  @@index([createdById])
}

// ============================================================
// VIDEO INTERACTION (COMMENTAIRES & SALUTATIONS SUR PRÉDICATIONS)
// ============================================================

model VideoInteraction {
  id String @id @default(cuid())

  videoId    String
  videoTitle String?

  type   InteractionType   @default(COMMENT)
  status InteractionStatus @default(NEW)

  authorName String
  contact    String?
  content    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video YouTubeVideo? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// EVENT IMAGE
// ============================================================
// Optional gallery images for events.
//
// The main cover image remains directly on Event.
// This model allows an event to have multiple additional images.
// ============================================================

model EventImage {
  id String @id @default(cuid())

  eventId String

  imageUrl       String
  imageKitFileId String?

  altText String?

  width  Int?
  height Int?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sortOrder])
}

// ============================================================
// POST (PUBLICATIONS SUR LA VIE DE L'ÉGLISE & TRAVAUX)
// ============================================================

model Post {
  id String @id @default(cuid())

  title       String
  slug        String        @unique
  description String?
  category    PostCategory  @default(CHURCH_LIFE)
  status      PostStatus    @default(PUBLISHED)
  visibility  Visibility    @default(PUBLIC)

  // Image principale de couverture
  coverImageUrl       String?
  coverImageKitFileId String?

  // Date de l'événement ou des travaux (optionnelle)
  eventDate DateTime?

  // Date de publication officielle
  publishedAt DateTime?

  // Auteur / administrateur
  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Galerie d'images associées (ex: photos des travaux)
  images PostImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([createdById])
}

model PostImage {
  id String @id @default(cuid())

  postId String

  imageUrl       String
  imageKitFileId String?
  caption        String?
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([sortOrder])
}

// ============================================================
// SERMON QUOTE (PHRASES IMPORTANTES / CITATIONS DE PRÉDICATIONS)
// ============================================================

model SermonQuote {
  id String @id @default(cuid())

  // La citation forte prononcée
  quote String

  // Prédicateur
  preacher String

  // Titre de la prédication ou enseignement
  sermonTitle String?

  // Date de la prédication
  sermonDate DateTime?

  // Photo associée (photo du prédicateur ou illustration)
  imageUrl       String?
  imageKitFileId String?

  // Thématique éventuelle (Foi, Prière, Sanctification, etc.)
  category String?

  // Statut de publication
  status QuoteStatus @default(PUBLISHED)

  publishedAt DateTime?

  // Auteur de la saisie
  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([preacher])
  @@index([publishedAt])
  @@index([createdById])
}
